{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rasp-shield.local/schemas/verification-report.schema.json",
  "title": "RASP Shield Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result", "warnings"],
  "properties": {
    "schema_version": { "const": 1 },
    "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT_IMPLEMENTED"] },
    "input": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "application": { "type": "object", "additionalProperties": true },
    "payload": { "type": "object", "additionalProperties": true },
    "signing": { "type": "object", "additionalProperties": true },
    "checks": { "type": "object", "additionalProperties": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}

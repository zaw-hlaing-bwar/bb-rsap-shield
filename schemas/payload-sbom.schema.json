{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rasp-shield.local/schemas/payload-sbom.schema.json",
  "title": "RASP Shield Payload SBOM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sbom_type",
    "payload_version",
    "components",
    "generated_by"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "sbom_type": { "const": "RASP_SHIELD_PAYLOAD_SBOM" },
    "payload_version": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "generated_by": { "$ref": "#/$defs/tool" }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "path", "sha256", "license"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["android_dex", "native_library", "license_notice"]
        },
        "abi": { "type": "string", "enum": ["arm64-v8a", "armeabi-v7a", "x86_64"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rasp-shield.local/schemas/payload-manifest.schema.json",
  "title": "RASP Shield Payload Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_version",
    "minimum_cli_version",
    "maximum_cli_version",
    "supported_platform",
    "supported_abis",
    "files"
  ],
  "properties": {
    "payload_version": { "type": "string", "minLength": 1 },
    "minimum_cli_version": { "type": "string", "minLength": 1 },
    "maximum_cli_version": { "type": "string", "minLength": 1 },
    "supported_platform": { "const": "android" },
    "supported_abis": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["arm64-v8a", "armeabi-v7a", "x86_64"] }
    },
    "files": {
      "type": "object",
      "required": ["bootstrap.dex", "sbom.json", "licenses/NOTICE.txt"],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Fa-f0-9]{64}$"
      }
    }
  }
}
